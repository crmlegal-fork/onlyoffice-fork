# syntax=docker/dockerfile:1.6
#
# OnlyOffice DocumentServer Fork — imagen oficial + branding Embitech.
#
# La edición libre de la 9.4 no limita las conexiones simultáneas, así que
# no se compila ni se sustituye el server: la única modificación es el
# branding (docker/branding/apply-branding.sh), que falla si algo no encaja.

FROM onlyoffice/documentserver:9.4.0.1

# ===== Branding: sustituir logos/strings ONLYOFFICE por Embitech =====
COPY docker/branding/ /tmp/branding/
RUN sed -i 's/\r$//' /tmp/branding/apply-branding.sh \
 && chmod +x /tmp/branding/apply-branding.sh \
 && /tmp/branding/apply-branding.sh \
 && rm -rf /tmp/branding

# Smoke test en build-time: si falla, el build entero falla.
RUN grep -qi "embitech" /var/www/onlyoffice/documentserver/web-apps/apps/common/main/resources/img/header/header-logo_s.svg \
 && [ ! -f /etc/supervisor/conf.d/ds-example.conf ] \
 && ! grep -q example /etc/supervisor/conf.d/ds.conf \
 && echo "OK: branding Embitech verificado"

# Healthcheck y entrypoint heredados de la imagen oficial:
#   ENTRYPOINT ["/app/ds/run-document-server.sh"]
#   EXPOSE 80 443
